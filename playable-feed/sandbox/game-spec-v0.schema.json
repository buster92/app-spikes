{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playloop.invalid/schemas/game-spec-v0.schema.json",
  "title": "Playloop GameSpec v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtime", "id", "title", "canvas", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtime": { "const": "playloop-2d-v0" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 160, "maximum": 1080 },
        "height": { "type": "integer", "minimum": 240, "maximum": 1920 },
        "background": { "type": "string", "maxLength": 64 }
      }
    },
    "variables": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "oneOf": [
          { "type": "number" },
          { "type": "boolean" },
          { "type": "string", "maxLength": 128 }
        ]
      }
    },
    "assets": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/asset" } },
    "templates": {
      "type": "object",
      "maxProperties": 24,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/entityTemplate" }
    },
    "entities": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/entity" } },
    "timers": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/timer" } },
    "rules": { "type": "array", "maxItems": 96, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "ref", "bytes", "mime"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["image", "audio"] },
        "ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 262144 },
        "mime": { "type": "string", "maxLength": 64 },
        "width": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "image" } }, "required": ["kind"] },
          "then": {
            "required": ["width", "height"],
            "properties": {
              "bytes": { "maximum": 98304 },
              "mime": { "enum": ["image/png", "image/webp", "image/avif"] }
            }
          },
          "else": {
            "properties": {
              "bytes": { "maximum": 131072 },
              "mime": { "enum": ["audio/ogg", "audio/webm", "audio/mp4"] }
            }
          }
        }
      ]
    },
    "entityTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["circle", "rect", "text", "sprite"] },
        "tags": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/id" } },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "vx": { "type": "number" },
        "vy": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "minimum": 0 },
        "rotation": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "type": "string", "maxLength": 64 },
        "text": { "type": "string", "maxLength": 256 },
        "bounds": { "enum": ["none", "clamp", "bounce", "wrap", "destroy"] },
        "asset": { "$ref": "#/$defs/id" },
        "collidable": { "type": "boolean" },
        "interactive": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "sprite" } }, "required": ["kind"] },
          "then": { "required": ["asset", "width", "height"] }
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["circle", "rect", "text", "sprite"] },
        "tags": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/id" } },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "vx": { "type": "number" },
        "vy": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "minimum": 0 },
        "rotation": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "type": "string", "maxLength": 64 },
        "text": { "type": "string", "maxLength": 256 },
        "bounds": { "enum": ["none", "clamp", "bounce", "wrap", "destroy"] },
        "asset": { "$ref": "#/$defs/id" },
        "collidable": { "type": "boolean" },
        "interactive": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "sprite" } }, "required": ["kind"] },
          "then": { "required": ["asset", "width", "height"] }
        }
      ]
    },
    "timer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "afterMs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "afterMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "everyMs": { "type": "integer", "minimum": 50, "maximum": 60000 }
      }
    },
    "expression": {
      "oneOf": [
        { "type": ["number", "string", "boolean", "null"] },
        { "type": "object", "additionalProperties": false, "required": ["var"], "properties": { "var": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["event"], "properties": { "event": { "enum": ["x", "y", "dx", "dy", "deltaMs"] } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["random"],
          "properties": {
            "random": {
              "type": "array",
              "prefixItems": [{ "type": "number" }, { "type": "number" }],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        { "$ref": "#/$defs/mathExpression" }
      ]
    },
    "mathExpression": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "add": { "$ref": "#/$defs/expressionList" },
        "sub": { "$ref": "#/$defs/expressionList" },
        "mul": { "$ref": "#/$defs/expressionList" },
        "div": { "$ref": "#/$defs/expressionList" },
        "min": { "$ref": "#/$defs/expressionList" },
        "max": { "$ref": "#/$defs/expressionList" }
      }
    },
    "expressionList": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/expression" } },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "op", "right"],
          "properties": {
            "left": { "$ref": "#/$defs/expression" },
            "op": { "enum": ["==", "!=", ">", ">=", "<", "<="] },
            "right": { "$ref": "#/$defs/expression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "entityRef": { "type": "string", "pattern": "^(\\$target|\\$a|\\$b|[a-z0-9][a-z0-9._-]{0,63})$" },
    "actions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/action" } },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/setVarAction" },
        { "$ref": "#/$defs/addVarAction" },
        { "$ref": "#/$defs/entityMutationAction" },
        { "$ref": "#/$defs/spawnAction" },
        { "$ref": "#/$defs/destroyAction" },
        { "$ref": "#/$defs/effectAction" },
        { "$ref": "#/$defs/finishAction" },
        { "$ref": "#/$defs/ifAction" }
      ]
    },
    "setVarAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setVar"],
      "properties": { "setVar": { "$ref": "#/$defs/varMutation" } }
    },
    "addVarAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addVar"],
      "properties": { "addVar": { "$ref": "#/$defs/varMutation" } }
    },
    "varMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "value": { "$ref": "#/$defs/expression" }
      }
    },
    "entityMutationAction": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "setEntity": { "$ref": "#/$defs/entityMutation" },
        "moveEntity": { "$ref": "#/$defs/entityMutation" },
        "setVelocity": { "$ref": "#/$defs/entityMutation" }
      }
    },
    "entityMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity"],
      "properties": {
        "entity": { "$ref": "#/$defs/entityRef" },
        "x": { "$ref": "#/$defs/expression" },
        "y": { "$ref": "#/$defs/expression" },
        "vx": { "$ref": "#/$defs/expression" },
        "vy": { "$ref": "#/$defs/expression" },
        "rotation": { "$ref": "#/$defs/expression" },
        "opacity": { "$ref": "#/$defs/expression" }
      }
    },
    "spawnAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spawn"],
      "properties": {
        "spawn": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template"],
          "properties": {
            "template": { "$ref": "#/$defs/id" },
            "id": { "$ref": "#/$defs/id" },
            "x": { "$ref": "#/$defs/expression" },
            "y": { "$ref": "#/$defs/expression" },
            "vx": { "$ref": "#/$defs/expression" },
            "vy": { "$ref": "#/$defs/expression" }
          }
        }
      }
    },
    "destroyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destroy"],
      "properties": {
        "destroy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity"],
          "properties": { "entity": { "$ref": "#/$defs/entityRef" } }
        }
      }
    },
    "effectAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["emit"],
          "properties": {
            "emit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "$ref": "#/$defs/id" },
                "data": {
                  "type": "object",
                  "maxProperties": 8,
                  "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                  "additionalProperties": {
                    "oneOf": [
                      { "type": "string", "maxLength": 128 },
                      { "type": "number" },
                      { "type": "boolean" },
                      { "type": "null" }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sound"],
          "properties": {
            "sound": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset"],
              "properties": {
                "asset": { "$ref": "#/$defs/id" },
                "volume": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["haptic"],
          "properties": {
            "haptic": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pattern"],
              "properties": {
                "pattern": { "type": "array", "maxItems": 6, "items": { "type": "integer", "minimum": 0, "maximum": 100 } }
              }
            }
          }
        }
      ]
    },
    "finishAction": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "complete": { "$ref": "#/$defs/finishPayload" },
        "fail": { "$ref": "#/$defs/finishPayload" }
      }
    },
    "finishPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": { "$ref": "#/$defs/expression" },
        "detail": { "type": "string", "maxLength": 160 }
      }
    },
    "ifAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["if"],
      "properties": {
        "if": {
          "type": "object",
          "additionalProperties": false,
          "required": ["condition", "then"],
          "properties": {
            "condition": { "$ref": "#/$defs/condition" },
            "then": { "$ref": "#/$defs/actions" },
            "else": { "$ref": "#/$defs/actions" }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "actions"],
      "properties": {
        "on": { "enum": ["start", "tick", "tap", "pointerDown", "pointerMove", "pointerUp", "timer", "collision", "entityExit"] },
        "timerId": { "$ref": "#/$defs/id" },
        "targetTag": { "$ref": "#/$defs/id" },
        "aTag": { "$ref": "#/$defs/id" },
        "bTag": { "$ref": "#/$defs/id" },
        "condition": { "$ref": "#/$defs/condition" },
        "actions": { "$ref": "#/$defs/actions" }
      }
    }
  }
}
