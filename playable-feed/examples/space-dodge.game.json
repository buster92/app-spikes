{
  "schemaVersion": 1,
  "runtime": "playloop-2d-v0",
  "id": "space-dodge",
  "title": "Space Dodge",
  "canvas": { "width": 360, "height": 560, "background": "#050915" },
  "variables": { "score": 0, "hits": 0 },
  "assets": [
    {
      "id": "space-bg",
      "kind": "image",
      "ref": "sha256:fe1dc859f896df3172cf307d032ed72000298ee08b77a88aaa8b7af6b5c64142",
      "bytes": 5746,
      "mime": "image/png",
      "width": 360,
      "height": 560
    },
    {
      "id": "space-atlas",
      "kind": "image",
      "ref": "sha256:523f731761fea9ae7f6e4221a28cef3ca0d526b5a6aaa1463d88b58bbb383ce5",
      "bytes": 954,
      "mime": "image/png",
      "width": 128,
      "height": 64
    }
  ],
  "templates": {
    "meteor": {
      "kind": "sprite",
      "asset": "space-atlas",
      "sourceX": 64,
      "sourceY": 0,
      "sourceWidth": 64,
      "sourceHeight": 64,
      "tags": ["hazard"],
      "width": 42,
      "height": 42,
      "vy": 210,
      "bounds": "destroy",
      "interactive": false
    }
  },
  "entities": [
    {
      "id": "background",
      "kind": "sprite",
      "asset": "space-bg",
      "x": 180,
      "y": 280,
      "width": 360,
      "height": 560,
      "collidable": false,
      "interactive": false
    },
    {
      "id": "player",
      "kind": "sprite",
      "asset": "space-atlas",
      "sourceX": 0,
      "sourceY": 0,
      "sourceWidth": 64,
      "sourceHeight": 64,
      "tags": ["player"],
      "x": 180,
      "y": 492,
      "width": 52,
      "height": 52,
      "bounds": "clamp",
      "interactive": false
    },
    {
      "id": "hint",
      "kind": "text",
      "x": 180,
      "y": 528,
      "height": 14,
      "text": "Drag anywhere to steer",
      "color": "#c8d5ff",
      "collidable": false,
      "interactive": false
    }
  ],
  "timers": [
    { "id": "spawn", "afterMs": 250, "everyMs": 480 },
    { "id": "score", "afterMs": 1000, "everyMs": 1000 },
    { "id": "finish", "afterMs": 12000 }
  ],
  "rules": [
    {
      "on": "pointerMove",
      "actions": [
        { "setEntity": { "entity": "player", "x": { "event": "x" }, "y": 492 } }
      ]
    },
    {
      "on": "pointerDown",
      "actions": [
        { "setEntity": { "entity": "player", "x": { "event": "x" }, "y": 492 } }
      ]
    },
    {
      "on": "timer",
      "timerId": "spawn",
      "actions": [
        {
          "spawn": {
            "template": "meteor",
            "x": { "random": [22, 338] },
            "y": -24,
            "vy": { "random": [190, 300] }
          }
        }
      ]
    },
    {
      "on": "timer",
      "timerId": "score",
      "actions": [
        { "addVar": { "name": "score", "value": 100 } }
      ]
    },
    {
      "on": "collision",
      "aTag": "player",
      "bTag": "hazard",
      "actions": [
        { "addVar": { "name": "hits", "value": 1 } },
        { "destroy": { "entity": "$b" } },
        { "haptic": { "pattern": [22, 25, 22] } },
        {
          "if": {
            "condition": { "left": { "var": "hits" }, "op": ">=", "right": 3 },
            "then": [
              { "fail": { "score": { "var": "score" }, "detail": "Three meteor hits" } }
            ]
          }
        }
      ]
    },
    {
      "on": "timer",
      "timerId": "finish",
      "actions": [
        { "complete": { "score": { "add": [{ "var": "score" }, 500] }, "detail": "Survived the meteor field" } }
      ]
    }
  ]
}
