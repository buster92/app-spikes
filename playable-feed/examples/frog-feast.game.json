{
  "schemaVersion": 1,
  "runtime": "playloop-2d-v0",
  "id": "frog-feast",
  "title": "Frog Feast",
  "canvas": { "width": 360, "height": 560, "background": "#68b8d2" },
  "variables": { "score": 0, "berries": 0, "stings": 0 },
  "assets": [
    {
      "id": "garden-bg",
      "kind": "image",
      "ref": "sha256:f470be529e414e51e6be1796a053a230dca73cfa13b1f1eb63628b2830ccd123",
      "bytes": 4199,
      "mime": "image/png",
      "width": 360,
      "height": 560
    },
    {
      "id": "garden-atlas",
      "kind": "image",
      "ref": "sha256:f97330389c6ab207c5c088618f6c153957f17550c60776e24dfb2475e57a6631",
      "bytes": 1287,
      "mime": "image/png",
      "width": 192,
      "height": 64
    }
  ],
  "templates": {
    "berry": {
      "kind": "sprite",
      "asset": "garden-atlas",
      "sourceX": 128,
      "sourceY": 0,
      "sourceWidth": 64,
      "sourceHeight": 64,
      "tags": ["collectible"],
      "width": 36,
      "height": 36,
      "vy": 175,
      "bounds": "destroy",
      "interactive": false
    },
    "bee": {
      "kind": "sprite",
      "asset": "garden-atlas",
      "sourceX": 64,
      "sourceY": 0,
      "sourceWidth": 64,
      "sourceHeight": 64,
      "tags": ["hazard"],
      "width": 38,
      "height": 38,
      "vy": 210,
      "bounds": "destroy",
      "interactive": false
    }
  },
  "entities": [
    {
      "id": "background",
      "kind": "sprite",
      "asset": "garden-bg",
      "x": 180,
      "y": 280,
      "width": 360,
      "height": 560,
      "collidable": false,
      "interactive": false
    },
    {
      "id": "player",
      "kind": "sprite",
      "asset": "garden-atlas",
      "sourceX": 0,
      "sourceY": 0,
      "sourceWidth": 64,
      "sourceHeight": 64,
      "tags": ["player"],
      "x": 180,
      "y": 482,
      "width": 60,
      "height": 60,
      "bounds": "clamp",
      "interactive": false
    },
    {
      "id": "hint",
      "kind": "text",
      "x": 180,
      "y": 530,
      "height": 14,
      "text": "Catch 8 berries · avoid 3 bees",
      "color": "#ffffff",
      "collidable": false,
      "interactive": false
    }
  ],
  "timers": [
    { "id": "spawn-berry", "afterMs": 250, "everyMs": 620 },
    { "id": "spawn-bee", "afterMs": 850, "everyMs": 1120 },
    { "id": "finish", "afterMs": 15000 }
  ],
  "rules": [
    {
      "on": "pointerMove",
      "actions": [
        { "setEntity": { "entity": "player", "x": { "event": "x" }, "y": 482 } }
      ]
    },
    {
      "on": "pointerDown",
      "actions": [
        { "setEntity": { "entity": "player", "x": { "event": "x" }, "y": 482 } }
      ]
    },
    {
      "on": "timer",
      "timerId": "spawn-berry",
      "actions": [
        {
          "spawn": {
            "template": "berry",
            "x": { "random": [22, 338] },
            "y": 300,
            "vy": { "random": [145, 215] }
          }
        }
      ]
    },
    {
      "on": "timer",
      "timerId": "spawn-bee",
      "actions": [
        {
          "spawn": {
            "template": "bee",
            "x": { "random": [24, 336] },
            "y": 285,
            "vy": { "random": [185, 260] }
          }
        }
      ]
    },
    {
      "on": "collision",
      "aTag": "player",
      "bTag": "collectible",
      "actions": [
        { "addVar": { "name": "berries", "value": 1 } },
        { "addVar": { "name": "score", "value": 150 } },
        { "destroy": { "entity": "$b" } },
        { "haptic": { "pattern": [9] } },
        {
          "if": {
            "condition": { "left": { "var": "berries" }, "op": ">=", "right": 8 },
            "then": [
              { "complete": { "score": { "add": [{ "var": "score" }, 400] }, "detail": "Eight berries caught" } }
            ]
          }
        }
      ]
    },
    {
      "on": "collision",
      "aTag": "player",
      "bTag": "hazard",
      "actions": [
        { "addVar": { "name": "stings", "value": 1 } },
        { "destroy": { "entity": "$b" } },
        { "haptic": { "pattern": [24, 28, 24] } },
        {
          "if": {
            "condition": { "left": { "var": "stings" }, "op": ">=", "right": 3 },
            "then": [
              { "fail": { "score": { "var": "score" }, "detail": "Three bee stings" } }
            ]
          }
        }
      ]
    },
    {
      "on": "timer",
      "timerId": "finish",
      "actions": [
        {
          "if": {
            "condition": { "left": { "var": "berries" }, "op": ">=", "right": 8 },
            "then": [
              { "complete": { "score": { "var": "score" }, "detail": "Berry target reached" } }
            ],
            "else": [
              { "fail": { "score": { "var": "score" }, "detail": "Not enough berries caught" } }
            ]
          }
        }
      ]
    }
  ]
}
